# Локальные настройки решения. preflight копирует этот файл в .env, если его нет.
# .env не коммитится (PLAN.md, 6.3).

# Имя базы данных решения. Пусто = имя папки решения.
# Задавайте только сознательно: копия папки вместе с .env будет писать в эту же базу.
SOLUTION_DB=

# Пароль роли <база>_analyst (только чтение). Пусто = роль не создаётся.
ANALYST_PASSWORD=

# Репозиторий организаторов для ./run.sh sync.
UPSTREAM_URL=https://github.com/daniilivanovp-droid/hackathon-students.git

# Наши файлы всегда с LF: run.sh и SQL выполняются в Linux-контейнере,
# а на Windows git по умолчанию выгружает CRLF (PLAN 6.3).
* text=auto eol=lf
*.sh text eol=lf

# Бинарные файлы не нормализуются и не диффаются как текст.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.xlsx binary
*.parquet binary
*.duckdb binary
